rule CXX_DYNDEP__ecs-benchmark-pico-ecs-extended_Debug
  command = "C:\Program Files\CMake\bin\cmake.exe" -E cmake_ninja_dyndep --tdi=benchmark\benchmarks\pico-ecs-extended\CMakeFiles\ecs-benchmark-pico-ecs-extended.dir\Debug\CXXDependInfo.json --lang=CXX --modmapfmt=gcc --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in
  restat = 1


